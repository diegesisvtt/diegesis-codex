{
  "name": "diegesis-codex",
  "productName": "Diegesis Codex",
  "version": "1.0.3",
  "description": "Multiplatform note-taking & worldbuilding studio (Electron + SQLite)",
  "main": "dist-electron/main.js",
  "author": "Patrick Porto",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "tsc -b && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir",
    "typecheck": "tsc -b --pretty",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@blocknote/ariakit": "^0.54.2",
    "@blocknote/core": "^0.54.2",
    "@blocknote/react": "^0.54.2",
    "@diegesis/core": "file:vendor/diegesis/diegesis-core-0.1.0.tgz",
    "@diegesis/dice": "file:vendor/diegesis/diegesis-dice-0.1.3.tgz",
    "@diegesis/dice-core": "file:vendor/diegesis/diegesis-dice-core-0.1.2.tgz",
    "@diegesis/dice-notation": "file:vendor/diegesis/diegesis-dice-notation-0.1.1.tgz",
    "@diegesis/events": "file:vendor/diegesis/diegesis-events-0.2.1.tgz",
    "@diegesis/formula": "file:vendor/diegesis/diegesis-formula-0.1.1.tgz",
    "@diegesis/inline-math": "file:vendor/diegesis/diegesis-inline-math-0.1.2.tgz",
    "@diegesis/roll-tables": "file:vendor/diegesis/diegesis-roll-tables-0.2.2.tgz",
    "@diegesis/sheet": "file:vendor/diegesis/diegesis-sheet-0.1.2.tgz",
    "@huggingface/transformers": "^4.2.0",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^11.10.0",
    "cannon-es": "^0.20.0",
    "flexlayout-react": "^0.7.12",
    "lucide-react": "^0.453.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-arborist": "^3.4.0",
    "react-dom": "^18.3.1",
    "sqlite-vec": "^0.1.9",
    "three": "^0.182.0"
  },
  "overrides": {
    "@diegesis/formula": "file:vendor/diegesis/diegesis-formula-0.1.1.tgz",
    "@diegesis/events": "file:vendor/diegesis/diegesis-events-0.2.1.tgz",
    "@diegesis/assets": "file:vendor/diegesis/diegesis-assets-0.1.2.tgz",
    "@diegesis/audio": "file:vendor/diegesis/diegesis-audio-0.2.1.tgz",
    "@diegesis/physics": "file:vendor/diegesis/diegesis-physics-0.1.1.tgz",
    "@diegesis/render3d": "file:vendor/diegesis/diegesis-render3d-0.1.1.tgz",
    "@diegesis/dice-core": "file:vendor/diegesis/diegesis-dice-core-0.1.2.tgz",
    "@diegesis/dice-notation": "file:vendor/diegesis/diegesis-dice-notation-0.1.1.tgz",
    "@diegesis/dice-notation-core": "file:vendor/diegesis/diegesis-dice-notation-core-0.1.1.tgz",
    "@diegesis/inline-math": "file:vendor/diegesis/diegesis-inline-math-0.1.2.tgz",
    "@diegesis/roll-tables": "file:vendor/diegesis/diegesis-roll-tables-0.2.2.tgz",
    "@diegesis/core": "file:vendor/diegesis/diegesis-core-0.1.0.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.24.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "wait-on": "^8.0.1"
  }
}
